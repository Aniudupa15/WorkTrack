<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: allow plain HTTP to the local Firebase emulators
         (see res/xml/network_security_config_debug.xml). Release builds keep
         Android's default of HTTPS-only. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:ignore="UnusedAttribute" />
</manifest>
