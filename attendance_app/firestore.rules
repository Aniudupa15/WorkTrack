rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin(companyId) { return signedIn() && role().data.role == 'admin' && role().data.companyId == companyId; }
    function isEmployee(companyId, employeeId) { return signedIn() && request.auth.uid == employeeId && role().data.role == 'employee' && role().data.companyId == companyId; }
    function onlyTokenChanged() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']); }

    // Identity, role, company, attendance, and employee lifecycle writes are server-owned.
    match /users/{userId} { allow read: if signedIn() && request.auth.uid == userId; }
    match /companies/{companyId} {
      allow read: if isAdmin(companyId);
      match /employees/{employeeId} {
        allow read: if isAdmin(companyId) || isEmployee(companyId, employeeId);
        allow update: if isEmployee(companyId, employeeId) && onlyTokenChanged();
      }
      match /attendance/{attendanceId} {
        allow read: if isAdmin(companyId) || (signedIn() && resource.data.employeeId == request.auth.uid && isEmployee(companyId, request.auth.uid));
      }
      match /leaves/{leaveId} {
        allow read: if isAdmin(companyId) || (signedIn() && resource.data.employeeId == request.auth.uid && isEmployee(companyId, request.auth.uid));
        allow create: if isEmployee(companyId, request.resource.data.employeeId) && request.resource.data.companyId == companyId && request.resource.data.status == 'pending' && request.resource.data.keys().hasOnly(['employeeId', 'companyId', 'employeeName', 'type', 'startDate', 'endDate', 'reason', 'status', 'createdAt', 'updatedAt', 'adminNote', 'id']);
        allow update: if isAdmin(companyId);
      }
    }
    match /notifications/{notificationId} { allow read: if signedIn() && (isAdmin(resource.data.companyId) || resource.data.employeeId == request.auth.uid); }
  }
}
